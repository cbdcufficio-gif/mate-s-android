# Carrera legacy mount candidate; no partition creation, resizing or formatting.
# Sources: acquired CRR-L09 boot fstab/init and observed by-name partition map.
# source                                                mount   type  mount_flags                                                                                                 fs_mgr_flags
/dev/block/platform/hi_mci.0/by-name/system               /system ext4  ro,barrier=1                                                                                                 wait
/dev/block/platform/hi_mci.0/by-name/cache                /cache  ext4  nosuid,nodev,noatime                                                                                          wait,check
/dev/block/platform/hi_mci.0/by-name/userdata             /data   ext4  rw,nosuid,nodev,noatime,user_xattr,acl,barrier=1,data=ordered,noauto_da_alloc,mblk_io_submit,discard                 wait,check,latemount,encryptable=footer
