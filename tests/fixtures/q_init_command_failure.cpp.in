#include <algorithm>
#include <cassert>
#include <iostream>
#include <memory>
#include <queue>
#include <string>
#include <variant>
#include <vector>
#define LOG(level) std::cerr
class Action {
public:
 bool failed=false;
 int later_commands=0;
 bool CheckEvent(int) const {return true;}
 std::string BuildTriggersString() const {return "fixture";}
 std::string filename() const {return "fixture.rc";}
 int line() const {return 1;}
 void ExecuteOneCommand(std::size_t command) {
  // Simulated mount failure; production Action::ExecuteCommand returns void.
  if(command==0) failed=true; else ++later_commands;
 }
 std::size_t NumCommands() const {return 2;}
 bool oneshot() const {return false;}
};
class ActionManager {
public:
 std::vector<std::unique_ptr<Action>> actions_;
 std::queue<std::variant<int>> event_queue_;
 std::queue<Action*> current_executing_actions_;
 std::size_t current_command_=0;
 void ExecuteOneCommand();
};
__PINNED_EXECUTE_ONE_COMMAND__
int main() {
 ActionManager manager;
 manager.actions_.emplace_back(std::make_unique<Action>());
 auto* action=manager.actions_[0].get();
 manager.event_queue_.emplace(1);
 manager.ExecuteOneCommand();
 assert(action->failed && action->later_commands==0);
 manager.ExecuteOneCommand();
 assert(action->later_commands==1);
 assert(manager.current_executing_actions_.empty());
}
