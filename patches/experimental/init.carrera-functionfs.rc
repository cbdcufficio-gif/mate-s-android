# Experimental preparation only. Not installed or imported by the product.
# Validate Huawei mount options, effective policy and init ordering before use.
# Endpoint labels must come from the pinned functionfs genfscon policy.
on init
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/f_ffs/aliases adb

# Gadget configuration, readiness race handling, and authenticated adbd
# activation are separate contracts. Do not enable the gadget from this file.
